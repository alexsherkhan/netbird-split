#!/bin/sh
set -eu

# Maintainer scripts are testable against a disposable prefix. The override is
# accepted only outside dpkg and only for temporary directories, so a package
# install cannot be redirected away from the real root.
NB_SPLIT_TEST_MODE="${NETBIRD_SPLIT_TEST_MODE:-0}"
NB_SPLIT_ROOT=""
if [ "$NB_SPLIT_TEST_MODE" = "1" ]; then
    if [ -n "${DPKG_MAINTSCRIPT_PACKAGE:-}" ]; then
        echo "netbird-split: refusing test mode while dpkg runs a maintainer script" >&2
        exit 1
    fi
    NB_SPLIT_ROOT="${NETBIRD_SPLIT_TEST_ROOT:-}"
    case "$NB_SPLIT_ROOT" in
        /tmp/* | /var/tmp/*) ;;
        *)
            echo "netbird-split: NETBIRD_SPLIT_TEST_ROOT must be under /tmp or /var/tmp" >&2
            exit 1
            ;;
    esac
fi

split_path() {
    printf '%s%s' "$NB_SPLIT_ROOT" "$1"
}

action_log="$(split_path /var/log/netbird-split-package-actions.log)"

record_action() {
    if [ "$NB_SPLIT_TEST_MODE" = "1" ]; then
        mkdir -p "$(dirname "$action_log")"
        printf '%s\n' "$*" >> "$action_log"
    fi
}

daemon_reload() {
    if [ "$NB_SPLIT_TEST_MODE" = "1" ]; then
        record_action "systemctl daemon-reload"
        return 0
    fi
    if command -v systemctl >/dev/null 2>&1; then
        systemctl daemon-reload >/dev/null 2>&1 || true
    fi
}

enable_unit() {
    if [ "$NB_SPLIT_TEST_MODE" = "1" ]; then
        record_action "systemctl enable netbird-split.service"
        return 0
    fi
    if command -v deb-systemd-helper >/dev/null 2>&1; then
        deb-systemd-helper enable netbird-split.service >/dev/null 2>&1 || true
    elif command -v systemctl >/dev/null 2>&1; then
        systemctl enable netbird-split.service >/dev/null 2>&1 || true
    fi
}

start_unit() {
    if [ "$NB_SPLIT_TEST_MODE" = "1" ]; then
        record_action "systemctl start netbird-split.service"
        return 0
    fi
    if command -v deb-systemd-invoke >/dev/null 2>&1; then
        deb-systemd-invoke start netbird-split.service >/dev/null 2>&1 || true
    elif command -v systemctl >/dev/null 2>&1; then
        systemctl start netbird-split.service >/dev/null 2>&1 || true
    fi
}

try_restart_unit() {
    if [ "$NB_SPLIT_TEST_MODE" = "1" ]; then
        record_action "systemctl try-restart netbird-split.service"
        return 0
    fi
    if ! command -v systemctl >/dev/null 2>&1; then
        return 0
    fi
    if ! systemctl is-active --quiet netbird-split.service; then
        return 0
    fi
    if command -v deb-systemd-invoke >/dev/null 2>&1; then
        deb-systemd-invoke restart netbird-split.service >/dev/null 2>&1 || true
    else
        systemctl restart netbird-split.service >/dev/null 2>&1 || true
    fi
}

make_directories() {
    install -d -m 0750 "$(split_path /var/lib/netbird-split)"
    install -d -m 0750 "$(split_path /var/log/netbird-split)"
    install -d -m 0755 "$(split_path /run/netbird-split)"
    install -d -m 0750 "$(split_path /etc/netbird-split)"
}

case "${1:-}" in
    configure)
        make_directories
        daemon_reload
        enable_unit
        if [ -z "${2:-}" ]; then
            start_unit
        else
            try_restart_unit
        fi
        ;;
    abort-upgrade | abort-remove | abort-deconfigure)
        make_directories
        daemon_reload
        enable_unit
        start_unit
        ;;
esac

exit 0
